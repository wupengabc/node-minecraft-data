{
  "_doc": {
    "description": "Maps every PascalCase csharpName from Minecraft-Console-Client/MinecraftClient/Protocol/Handlers/PacketPalettes/PacketPalette261.cs to a minecraft-data snake_case packet name, grouped by direction. The four directions correspond to PacketPalette261's typeIn / typeOut / configurationTypesIn / configurationTypesOut dictionaries. snake_case names follow the existing minecraft-data convention seen in data/pc/1.21.11/protocol.json for shared packets; 26.1-new packets (GameRuleValues, LowDiskSpaceWarning, SetGameRule, Attack, etc.) use the snake_case names documented in the spec.",
    "source": "Minecraft-Console-Client/MinecraftClient/Protocol/Handlers/PacketPalettes/PacketPalette261.cs",
    "consumer": "minecraft-data/tools/verify-palette-261.js (lookup is nameMap[direction][csharpName])",
    "directions": [
      "playToClient",
      "playToServer",
      "configurationToClient",
      "configurationToServer"
    ]
  },
